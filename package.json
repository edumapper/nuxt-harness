    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edumapper/nuxt-harness.git",
    "directory": "packages/nuxt-harness"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "eslint": "10.0.3",
    "eslint-plugin-vue": "10.8.0",
    "typescript": "5.9.3",
    "vue-eslint-parser": "10.4.0"
  }
}
